      <elementParameter field="MEMO_JAVA" name="CODE" value="// code sample:&#10;//&#10;// multiply by 2 the row identifier&#10;// output_row.id = input_row.id * 2;&#10;//&#10;// lowercase the name&#10;// output_row.name = input_row.name.toLowerCase();&#10;&#10;if (input_row.message_type.equals(&quot;begin&quot;)) {&#10;&#9;globalMap.put(&quot;job_start_time&quot;, input_row.moment);&#10;}&#10;&#10;if (input_row.message_type.equals(&quot;end&quot;)) {&#10;&#9;&#10;&#9;globalMap.put(&quot;job_end_time&quot;, input_row.moment);&#10;&#9;globalMap.put(&quot;job_execution_status&quot;, input_row.message);&#10;&#9;globalMap.put(&quot;job_execution_duration&quot;, input_row.duration);&#10;&#10;&#9;// place holder error field values in case no errros occured&#10;&#9;if (globalMap.get(&quot;job_error_type&quot;) == null) {&#10;&#9;&#9;globalMap.put(&quot;job_error_type&quot;, &quot;&quot;);&#10;&#9;&#9;globalMap.put(&quot;job_error_message&quot;, &quot;&quot;);&#10;&#9;&#9;globalMap.put(&quot;job_error_code&quot;, 0);&#9;&#10;&#9;}&#10;&#9;&#10;&#9;&#10;&#9;//System.out.println(&quot;aaaa:&quot;+globalMap.get(&quot;job_execution_duration&quot;));&#10;&#9;// Global var - triggers sending audit logs to DB&#10;&#9;globalMap.put(&quot;job_ended&quot;, &quot;YES&quot;);&#10;}&#10;&#10;/*System.out.println(&quot;-----------------&quot;);&#10;if(globalMap.get(&quot;job_ended&quot;).equals(&quot;YES&quot;)) {&#10;System.out.println(&quot;***************************&quot;);&#10;System.out.println(&quot;RUN_DATE:&quot;+context.sc_execution_run_date);&#10;System.out.println(&quot;JOB_ID:&quot;+context.sc_execution_job_id);&#10;System.out.println(&quot;RUN_ID:&quot;+context.sc_execution_run_id);&#10;System.out.println(&quot;START_TIME:&quot;+(java.util.Date) globalMap.get(&quot;job_start_time&quot;));&#10;System.out.println(&quot;END_TIME:&quot;+(java.util.Date) globalMap.get(&quot;job_end_time&quot;));&#10;System.out.println(&quot;Duration: &quot; + ((Long)globalMap.get(&quot;job_execution_duration&quot;)) /1000);&#10;System.out.println(&quot;INPUTPUT_ROWS:&quot;+(Integer) globalMap.get(&quot;job_number_of_rows_input&quot;));&#10;System.out.println(&quot;OUTPUT_ROWS:&quot;+(Integer) globalMap.get(&quot;job_number_of_rows_output&quot;));&#10;System.out.println(&quot;ERROR_TYPE:&quot;+(String) globalMap.get(&quot;job_error_type&quot;));&#10;System.out.println(&quot;ERROR_MESSAGE:&quot;+(String) globalMap.get(&quot;job_error_message&quot;));&#10;System.out.println(&quot;ERROR_CODE:&quot;+(Integer) globalMap.get(&quot;job_error_code&quot;));&#10;System.out.println(&quot;STATUS:&quot;+(String)globalMap.get(&quot;job_execution_status&quot;));&#10;System.out.println(&quot;JOB_ENDED:&quot;+(String) globalMap.get(&quot;job_ended&quot;));&#10;System.out.println(&quot;***************************&quot;);&#10;}&#10;*/"/>

      <elementParameter field="MEMO_JAVA" name="CODE" value="//int num_input_rows = (Integer) globalMap.get(&quot;job_number_of_rows_input&quot;);&#10;//int num_output_rows = (Integer) globalMap.get(&quot;job_number_of_rows_output&quot;);&#10;int num_input_rows = (Integer) globalMap.get(&quot;NUM_INPUT_ROWS&quot;);&#10;int num_output_rows =(Integer) globalMap.get(&quot;NUM_OUTPUT_ROWS&quot;);&#10;&#10;System.out.println(&quot;input:&quot;+num_input_rows);&#10;System.out.println(&quot;output:&quot;+num_output_rows);&#10;String job_execution_status = (String)globalMap.get(&quot;job_execution_status&quot;);&#10;&#10; if((boolean)((job_execution_status.equals(&quot;success&quot;)) &amp;&amp; (num_input_rows==num_output_rows)))&#10; { &#10;  globalMap.put(&quot;STATUS&quot;, &quot;Y&quot;);&#10;  System.out.println(&quot;INSIDE SUCCESS BLOCK&quot;);&#10;  //System.out.println(&quot;STATUS:&quot;+(String)globalMap.get(&quot;job_execution_status&quot;));&#10;  }&#10;  else &#10; {&#10; globalMap.put(&quot;STATUS&quot;, &quot;N&quot;);&#10; System.out.println(&quot;INSIDE FAILURE BLOCK&quot;);&#10; //System.out.println(&quot;STATUS:&quot;+(String)globalMap.get(&quot;job_execution_status&quot;));&#10; }&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;if(globalMap.get(&quot;job_ended&quot;).equals(&quot;YES&quot;)) {&#10;System.out.println(&quot;***************************&quot;);&#10;System.out.println(&quot;RUN_DATE:&quot;+context.sc_execution_run_date);&#10;System.out.println(&quot;JOB_ID:&quot;+context.sc_execution_job_id);&#10;System.out.println(&quot;RUN_ID:&quot;+context.sc_execution_run_id);&#10;System.out.println(&quot;START_TIME:&quot;+(java.util.Date) globalMap.get(&quot;job_start_time&quot;));&#10;System.out.println(&quot;END_TIME:&quot;+(java.util.Date) globalMap.get(&quot;job_end_time&quot;));&#10;System.out.println(&quot;Duration: &quot; + ((Long)globalMap.get(&quot;job_execution_duration&quot;)) /1000);&#10;System.out.println(&quot;INPUTPUT_ROWS:&quot;+(Integer) globalMap.get(&quot;NUM_INPUT_ROWS&quot;));&#10;System.out.println(&quot;OUTPUT_ROWS:&quot;+(Integer) globalMap.get(&quot;NUM_OUTPUT_ROWS&quot;));&#10;System.out.println(&quot;ERROR_TYPE:&quot;+(String) globalMap.get(&quot;job_error_type&quot;));&#10;System.out.println(&quot;ERROR_MESSAGE:&quot;+(String) globalMap.get(&quot;job_error_message&quot;));&#10;System.out.println(&quot;ERROR_CODE:&quot;+(Integer) globalMap.get(&quot;job_error_code&quot;));&#10;System.out.println(&quot;STATUS:&quot;+(String)globalMap.get(&quot;job_execution_status&quot;));&#10;System.out.println(&quot;JOB_ENDED:&quot;+(String) globalMap.get(&quot;job_ended&quot;));&#10;System.out.println(&quot;***************************&quot;);&#10;}&#10;&#10;"/>

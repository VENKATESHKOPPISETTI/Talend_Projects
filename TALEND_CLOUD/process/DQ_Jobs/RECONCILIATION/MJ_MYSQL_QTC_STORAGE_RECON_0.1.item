  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="320" posY="80">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_InitRun" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (context.run_id == null || context.run_id.trim().isEmpty()) {&#xA;    context.run_id = &quot;RECON_&quot; + java.time.format.DateTimeFormatter.ofPattern(&quot;yyyyMMdd_HHmmss_SSS&quot;)&#xA;        .withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())&#xA;        + &quot;_&quot; + java.util.UUID.randomUUID().toString().substring(0, 8);&#xA;}&#xA;if (context.cutoff_ts == null || context.cutoff_ts.trim().isEmpty()) {&#xA;    context.cutoff_ts = new java.sql.Timestamp(System.currentTimeMillis()).toString();&#xA;}&#xA;globalMap.put(&quot;RECON_RUN_ID&quot;, context.run_id);&#xA;globalMap.put(&quot;RECON_CUTOFF&quot;, context.cutoff_ts);&#xA;System.out.println(&quot;Starting reconciliation run &quot; + context.run_id + &quot; at cutoff &quot; + context.cutoff_ts);&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>

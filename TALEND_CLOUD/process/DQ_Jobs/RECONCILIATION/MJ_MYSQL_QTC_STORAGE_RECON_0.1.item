  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1040" posY="80">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_ExecuteRecon" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String[] identifiers = {&#xD;&#xA;&#x9;    context.sf_database, context.sf_qtc_storage_schema, context.sf_curated_schema,&#xD;&#xA;&#x9;    context.sf_control_schema, context.sf_exception_schema, context.mysql_database&#xD;&#xA;&#x9;};&#xD;&#xA;&#x9;for (String identifier : identifiers) {&#xD;&#xA;&#x9;    if (identifier == null || !identifier.matches(&quot;[A-Za-z_][A-Za-z0-9_$]*&quot;)) {&#xD;&#xA;&#x9;        throw new IllegalArgumentException(&quot;Unsafe or empty identifier: &quot; + identifier);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;final java.sql.Connection mysql = (java.sql.Connection) globalMap.get(&quot;conn_tMysqlConnection_1&quot;);&#xD;&#xA;&#x9;final java.sql.Connection sf = (java.sql.Connection) globalMap.get(&quot;conn_tDBConnection_1&quot;);&#xD;&#xA;&#x9;if (mysql == null || sf == null) throw new IllegalStateException(&quot;MySQL or Snowflake connection is unavailable.&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;// Quote every identifier to preserve exact case. The raw/storage schema and its&#xD;&#xA;&#x9;// tables/columns were created case-sensitive lowercase by the ingestion pipeline&#xD;&#xA;&#x9;// (e.g. &quot;mysql_to_snowflake_demo_storage&quot;.&quot;customer&quot;.&quot;customer_id&quot;), so every&#xD;&#xA;&#x9;// reference into that schema must be quoted lowercase or Snowflake folds it to&#xD;&#xA;&#x9;// uppercase and the object &quot;doesn't exist&quot;.&#xD;&#xA;&#x9;final java.util.function.Function&lt;String, String> q = s -> &quot;\&quot;&quot; + s.replace(&quot;\&quot;&quot;, &quot;\&quot;\&quot;&quot;) + &quot;\&quot;&quot;;&#xD;&#xA;&#xD;&#xA;&#x9;final String db = q.apply(context.sf_database);&#xD;&#xA;&#x9;final String raw = db + &quot;.&quot; + q.apply(context.sf_qtc_storage_schema);&#xD;&#xA;&#x9;final String curated = db + &quot;.&quot; + context.sf_curated_schema;&#xD;&#xA;&#x9;final String control = db + &quot;.&quot; + context.sf_control_schema;&#xD;&#xA;&#x9;final String exception = db + &quot;.&quot; + context.sf_exception_schema;&#xD;&#xA;&#x9;final java.math.BigDecimal tolerance = new java.math.BigDecimal(context.amount_tolerance);&#xD;&#xA;&#x9;final String runId = context.run_id;&#xD;&#xA;&#x9;final String cutoff = context.cutoff_ts;&#xD;&#xA;&#x9;int failedControls = 0;&#xD;&#xA;&#xD;&#xA;&#x9;// Raw (source) table references - lowercase quoted, matching the DQ job's convention.&#xD;&#xA;&#x9;final String rawCustomer = raw + &quot;.\&quot;customer\&quot;&quot;;&#xD;&#xA;&#x9;final String rawOrders   = raw + &quot;.\&quot;orders\&quot;&quot;;&#xD;&#xA;&#x9;final String rawPayments = raw + &quot;.\&quot;payments\&quot;&quot;;&#xD;&#xA;&#xD;&#xA;&#x9;class ReconHelper {&#xD;&#xA;&#x9;    java.math.BigDecimal scalar(java.sql.Connection conn, String sql, String cutoffValue) throws Exception {&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = conn.prepareStatement(sql)) {&#xD;&#xA;&#x9;            if (cutoffValue != null) ps.setString(1, cutoffValue);&#xD;&#xA;&#x9;            try (java.sql.ResultSet rs = ps.executeQuery()) {&#xD;&#xA;&#x9;                if (!rs.next()) return java.math.BigDecimal.ZERO;&#xD;&#xA;&#x9;                java.math.BigDecimal value = rs.getBigDecimal(1);&#xD;&#xA;&#x9;                return value == null ? java.math.BigDecimal.ZERO : value;&#xD;&#xA;&#x9;            }&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    java.util.Set&lt;String> keys(java.sql.Connection conn, String sql, String cutoffValue) throws Exception {&#xD;&#xA;&#x9;        java.util.Set&lt;String> values = new java.util.HashSet&lt;String>();&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = conn.prepareStatement(sql)) {&#xD;&#xA;&#x9;            ps.setString(1, cutoffValue);&#xD;&#xA;&#x9;            try (java.sql.ResultSet rs = ps.executeQuery()) {&#xD;&#xA;&#x9;                while (rs.next()) values.add(String.valueOf(rs.getObject(1)));&#xD;&#xA;&#x9;            }&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        return values;&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    String status(java.math.BigDecimal sourceValue, java.math.BigDecimal targetValue, java.math.BigDecimal allowed) {&#xD;&#xA;&#x9;        return sourceValue.subtract(targetValue).abs().compareTo(allowed) &lt;= 0 ? &quot;PASSED&quot; : &quot;FAILED&quot;;&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    void add(String controlName, String entity, String severity, java.math.BigDecimal sourceValue,&#xD;&#xA;&#x9;             java.math.BigDecimal targetValue, String status, String detail) throws Exception {&#xD;&#xA;&#x9;        String insert = &quot;INSERT INTO &quot; + control + &quot;.RECONCILIATION_DETAIL (RUN_ID,CONTROL_NAME,ENTITY_NAME,SEVERITY,SOURCE_VALUE,TARGET_VALUE,DIFFERENCE_VALUE,STATUS,DETAIL_TEXT,CREATED_AT) VALUES (?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP())&quot;;&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = sf.prepareStatement(insert)) {&#xD;&#xA;&#x9;            ps.setString(1, runId); ps.setString(2, controlName); ps.setString(3, entity); ps.setString(4, severity);&#xD;&#xA;&#x9;            ps.setBigDecimal(5, sourceValue); ps.setBigDecimal(6, targetValue);&#xD;&#xA;&#x9;            ps.setBigDecimal(7, sourceValue.subtract(targetValue)); ps.setString(8, status); ps.setString(9, detail);&#xD;&#xA;&#x9;            ps.executeUpdate();&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;ReconHelper h = new ReconHelper();&#xD;&#xA;&#xD;&#xA;&#x9;sf.setAutoCommit(false);&#xD;&#xA;&#x9;try (java.sql.Statement st = sf.createStatement()) {&#xD;&#xA;&#x9;    st.execute(&quot;CREATE SCHEMA IF NOT EXISTS &quot; + control);&#xD;&#xA;&#x9;    st.execute(&quot;CREATE TABLE IF NOT EXISTS &quot; + control + &quot;.RECONCILIATION_RUN (RUN_ID VARCHAR, DQ_RUN_ID VARCHAR, CUTOFF_TS TIMESTAMP_NTZ, ENVIRONMENT VARCHAR, START_TS TIMESTAMP_LTZ, END_TS TIMESTAMP_LTZ, STATUS VARCHAR, TOTAL_CONTROLS NUMBER, FAILED_CONTROLS NUMBER, WARNING_CONTROLS NUMBER, ERROR_MESSAGE VARCHAR)&quot;);&#xD;&#xA;&#x9;    st.execute(&quot;CREATE TABLE IF NOT EXISTS &quot; + control + &quot;.RECONCILIATION_DETAIL (RUN_ID VARCHAR, CONTROL_NAME VARCHAR, ENTITY_NAME VARCHAR, SEVERITY VARCHAR, SOURCE_VALUE NUMBER(38,4), TARGET_VALUE NUMBER(38,4), DIFFERENCE_VALUE NUMBER(38,4), STATUS VARCHAR, DETAIL_TEXT VARCHAR, CREATED_AT TIMESTAMP_LTZ)&quot;);&#xD;&#xA;&#x9;    st.execute(&quot;CREATE OR REPLACE VIEW &quot; + control + &quot;.RECONCILIATION_SUMMARY AS SELECT RUN_ID,ENTITY_NAME,COUNT(*) CONTROL_COUNT,COUNT_IF(STATUS='FAILED') FAILED_COUNT,COUNT_IF(STATUS='WARNING') WARNING_COUNT,MAX(CREATED_AT) LAST_CHECK_TS FROM &quot; + control + &quot;.RECONCILIATION_DETAIL GROUP BY RUN_ID,ENTITY_NAME&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;    if (context.dq_run_id == null || context.dq_run_id.trim().isEmpty()) {&#xD;&#xA;&#x9;        try (java.sql.ResultSet rs = st.executeQuery(&quot;SELECT RUN_ID FROM &quot; + control + &quot;.DQ_RUN WHERE STATUS LIKE 'COMPLETED%' ORDER BY END_TS DESC LIMIT 1&quot;)) {&#xD;&#xA;&#x9;            if (rs.next()) context.dq_run_id = rs.getString(1);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    if (context.dq_run_id == null || context.dq_run_id.trim().isEmpty()) {&#xD;&#xA;&#x9;        throw new IllegalStateException(&quot;No completed DQ run was found. Run MJ_QTC_STORAGE_TO_CURATED_DQ first or supply dq_run_id.&quot;);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + control + &quot;.RECONCILIATION_DETAIL WHERE RUN_ID='&quot; + runId.replace(&quot;'&quot;, &quot;''&quot;) + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + control + &quot;.RECONCILIATION_RUN WHERE RUN_ID='&quot; + runId.replace(&quot;'&quot;, &quot;''&quot;) + &quot;'&quot;);&#xD;&#xA;&#x9;    try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;INSERT INTO &quot; + control + &quot;.RECONCILIATION_RUN (RUN_ID,DQ_RUN_ID,CUTOFF_TS,ENVIRONMENT,START_TS,STATUS) SELECT ?,?,TO_TIMESTAMP_NTZ(?),?,CURRENT_TIMESTAMP(),'RUNNING'&quot;)) {&#xD;&#xA;&#x9;        ps.setString(1, runId); ps.setString(2, context.dq_run_id); ps.setString(3, cutoff); ps.setString(4, context.environment); ps.executeUpdate();&#xD;&#xA;&#x9;    }&#xD;&#xA;&#xD;&#xA;&#x9;    // ===================== CUSTOMER =====================&#xD;&#xA;&#x9;    {&#xD;&#xA;&#x9;        java.math.BigDecimal sourceCount = h.scalar(mysql, &quot;SELECT COUNT(*) FROM customer WHERE updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;        java.math.BigDecimal rawCount = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawCustomer + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        String status = h.status(sourceCount, rawCount, java.math.BigDecimal.ZERO);&#xD;&#xA;&#x9;        h.add(&quot;SOURCE_TO_QTC_STORAGE_ROW_COUNT&quot;, &quot;CUSTOMER&quot;, &quot;CRITICAL&quot;, sourceCount, rawCount, status, &quot;MySQL eligible rows versus the QTC Snowflake Storage/current table at the common cutoff&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.math.BigDecimal curatedCount = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + curated + &quot;.CUSTOMER WHERE UPDATED_AT &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        java.math.BigDecimal rejectCount;&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;SELECT COUNT(DISTINCT RECORD_KEY) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID=? AND ENTITY_NAME=? AND SEVERITY IN ('CRITICAL','MAJOR')&quot;)) {&#xD;&#xA;&#x9;            ps.setString(1, context.dq_run_id); ps.setString(2, &quot;CUSTOMER&quot;);&#xD;&#xA;&#x9;            try (java.sql.ResultSet rs = ps.executeQuery()) { rs.next(); rejectCount = rs.getBigDecimal(1); if (rejectCount == null) rejectCount = java.math.BigDecimal.ZERO; }&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        java.math.BigDecimal accounted = curatedCount.add(rejectCount);&#xD;&#xA;&#x9;        status = h.status(rawCount, accounted, java.math.BigDecimal.ZERO);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_TO_CURATED_PLUS_REJECTS&quot;, &quot;CUSTOMER&quot;, &quot;CRITICAL&quot;, rawCount, accounted, status, &quot;QTC Storage rows must equal CURATED rows plus distinct blocking rejected keys&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.util.Set&lt;String> sourceKeys = h.keys(mysql, &quot;SELECT customer_id FROM customer WHERE updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;        java.util.Set&lt;String> rawKeys = h.keys(sf, &quot;SELECT \&quot;customer_id\&quot; FROM &quot; + rawCustomer + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        java.util.Set&lt;String> missing = new java.util.HashSet&lt;String>(sourceKeys); missing.removeAll(rawKeys);&#xD;&#xA;&#x9;        java.util.Set&lt;String> extra = new java.util.HashSet&lt;String>(rawKeys); extra.removeAll(sourceKeys);&#xD;&#xA;&#x9;        h.add(&quot;MISSING_KEYS_IN_QTC_STORAGE&quot;, &quot;CUSTOMER&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, new java.math.BigDecimal(missing.size()), missing.isEmpty()?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Keys present in MySQL but absent from QTC Storage&quot;);&#xD;&#xA;&#x9;        h.add(&quot;EXTRA_KEYS_IN_QTC_STORAGE&quot;, &quot;CUSTOMER&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, new java.math.BigDecimal(extra.size()), extra.isEmpty()?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Keys present in QTC Storage but absent from MySQL at cutoff&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.math.BigDecimal duplicates = h.scalar(sf, &quot;SELECT COALESCE(SUM(CNT-1),0) FROM (SELECT COUNT(*) CNT FROM &quot; + rawCustomer + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?) GROUP BY \&quot;customer_id\&quot; HAVING COUNT(*)>1)&quot;, cutoff);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_DUPLICATE_KEYS&quot;, &quot;CUSTOMER&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, duplicates, duplicates.compareTo(java.math.BigDecimal.ZERO)==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Duplicate business-key rows in QTC Storage&quot;);&#xD;&#xA;&#x9;        java.math.BigDecimal nullKeys = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawCustomer + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?) AND \&quot;customer_id\&quot; IS NULL&quot;, cutoff);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_NULL_KEYS&quot;, &quot;CUSTOMER&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, nullKeys, nullKeys.compareTo(java.math.BigDecimal.ZERO)==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Null primary keys in QTC Storage&quot;);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#xD;&#xA;&#x9;    // ===================== ORDERS =====================&#xD;&#xA;&#x9;    {&#xD;&#xA;&#x9;        java.math.BigDecimal sourceCount = h.scalar(mysql, &quot;SELECT COUNT(*) FROM orders WHERE updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;        java.math.BigDecimal rawCount = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawOrders + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        String status = h.status(sourceCount, rawCount, java.math.BigDecimal.ZERO);&#xD;&#xA;&#x9;        h.add(&quot;SOURCE_TO_QTC_STORAGE_ROW_COUNT&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, sourceCount, rawCount, status, &quot;MySQL eligible rows versus the QTC Snowflake Storage/current table at the common cutoff&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.math.BigDecimal curatedCount = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + curated + &quot;.ORDERS WHERE UPDATED_AT &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        java.math.BigDecimal rejectCount;&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;SELECT COUNT(DISTINCT RECORD_KEY) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID=? AND ENTITY_NAME=? AND SEVERITY IN ('CRITICAL','MAJOR')&quot;)) {&#xD;&#xA;&#x9;            ps.setString(1, context.dq_run_id); ps.setString(2, &quot;ORDERS&quot;);&#xD;&#xA;&#x9;            try (java.sql.ResultSet rs = ps.executeQuery()) { rs.next(); rejectCount = rs.getBigDecimal(1); if (rejectCount == null) rejectCount = java.math.BigDecimal.ZERO; }&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        java.math.BigDecimal accounted = curatedCount.add(rejectCount);&#xD;&#xA;&#x9;        status = h.status(rawCount, accounted, java.math.BigDecimal.ZERO);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_TO_CURATED_PLUS_REJECTS&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, rawCount, accounted, status, &quot;QTC Storage rows must equal CURATED rows plus distinct blocking rejected keys&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.util.Set&lt;String> sourceKeys = h.keys(mysql, &quot;SELECT order_id FROM orders WHERE updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;        java.util.Set&lt;String> rawKeys = h.keys(sf, &quot;SELECT \&quot;order_id\&quot; FROM &quot; + rawOrders + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        java.util.Set&lt;String> missing = new java.util.HashSet&lt;String>(sourceKeys); missing.removeAll(rawKeys);&#xD;&#xA;&#x9;        java.util.Set&lt;String> extra = new java.util.HashSet&lt;String>(rawKeys); extra.removeAll(sourceKeys);&#xD;&#xA;&#x9;        h.add(&quot;MISSING_KEYS_IN_QTC_STORAGE&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, new java.math.BigDecimal(missing.size()), missing.isEmpty()?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Keys present in MySQL but absent from QTC Storage&quot;);&#xD;&#xA;&#x9;        h.add(&quot;EXTRA_KEYS_IN_QTC_STORAGE&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, new java.math.BigDecimal(extra.size()), extra.isEmpty()?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Keys present in QTC Storage but absent from MySQL at cutoff&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.math.BigDecimal duplicates = h.scalar(sf, &quot;SELECT COALESCE(SUM(CNT-1),0) FROM (SELECT COUNT(*) CNT FROM &quot; + rawOrders + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?) GROUP BY \&quot;order_id\&quot; HAVING COUNT(*)>1)&quot;, cutoff);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_DUPLICATE_KEYS&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, duplicates, duplicates.compareTo(java.math.BigDecimal.ZERO)==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Duplicate business-key rows in QTC Storage&quot;);&#xD;&#xA;&#x9;        java.math.BigDecimal nullKeys = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawOrders + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?) AND \&quot;order_id\&quot; IS NULL&quot;, cutoff);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_NULL_KEYS&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, nullKeys, nullKeys.compareTo(java.math.BigDecimal.ZERO)==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Null primary keys in QTC Storage&quot;);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#xD;&#xA;&#x9;    // ===================== PAYMENTS =====================&#xD;&#xA;&#x9;    {&#xD;&#xA;&#x9;        java.math.BigDecimal sourceCount = h.scalar(mysql, &quot;SELECT COUNT(*) FROM payments WHERE updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;        java.math.BigDecimal rawCount = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawPayments + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        String status = h.status(sourceCount, rawCount, java.math.BigDecimal.ZERO);&#xD;&#xA;&#x9;        h.add(&quot;SOURCE_TO_QTC_STORAGE_ROW_COUNT&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, sourceCount, rawCount, status, &quot;MySQL eligible rows versus the QTC Snowflake Storage/current table at the common cutoff&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.math.BigDecimal curatedCount = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + curated + &quot;.PAYMENTS WHERE UPDATED_AT &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        java.math.BigDecimal rejectCount;&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;SELECT COUNT(DISTINCT RECORD_KEY) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID=? AND ENTITY_NAME=? AND SEVERITY IN ('CRITICAL','MAJOR')&quot;)) {&#xD;&#xA;&#x9;            ps.setString(1, context.dq_run_id); ps.setString(2, &quot;PAYMENTS&quot;);&#xD;&#xA;&#x9;            try (java.sql.ResultSet rs = ps.executeQuery()) { rs.next(); rejectCount = rs.getBigDecimal(1); if (rejectCount == null) rejectCount = java.math.BigDecimal.ZERO; }&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        java.math.BigDecimal accounted = curatedCount.add(rejectCount);&#xD;&#xA;&#x9;        status = h.status(rawCount, accounted, java.math.BigDecimal.ZERO);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_TO_CURATED_PLUS_REJECTS&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, rawCount, accounted, status, &quot;QTC Storage rows must equal CURATED rows plus distinct blocking rejected keys&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.util.Set&lt;String> sourceKeys = h.keys(mysql, &quot;SELECT payment_id FROM payments WHERE updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;        java.util.Set&lt;String> rawKeys = h.keys(sf, &quot;SELECT \&quot;payment_id\&quot; FROM &quot; + rawPayments + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;        java.util.Set&lt;String> missing = new java.util.HashSet&lt;String>(sourceKeys); missing.removeAll(rawKeys);&#xD;&#xA;&#x9;        java.util.Set&lt;String> extra = new java.util.HashSet&lt;String>(rawKeys); extra.removeAll(sourceKeys);&#xD;&#xA;&#x9;        h.add(&quot;MISSING_KEYS_IN_QTC_STORAGE&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, new java.math.BigDecimal(missing.size()), missing.isEmpty()?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Keys present in MySQL but absent from QTC Storage&quot;);&#xD;&#xA;&#x9;        h.add(&quot;EXTRA_KEYS_IN_QTC_STORAGE&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, new java.math.BigDecimal(extra.size()), extra.isEmpty()?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Keys present in QTC Storage but absent from MySQL at cutoff&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        java.math.BigDecimal duplicates = h.scalar(sf, &quot;SELECT COALESCE(SUM(CNT-1),0) FROM (SELECT COUNT(*) CNT FROM &quot; + rawPayments + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?) GROUP BY \&quot;payment_id\&quot; HAVING COUNT(*)>1)&quot;, cutoff);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_DUPLICATE_KEYS&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, duplicates, duplicates.compareTo(java.math.BigDecimal.ZERO)==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Duplicate business-key rows in QTC Storage&quot;);&#xD;&#xA;&#x9;        java.math.BigDecimal nullKeys = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawPayments + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?) AND \&quot;payment_id\&quot; IS NULL&quot;, cutoff);&#xD;&#xA;&#x9;        h.add(&quot;QTC_STORAGE_NULL_KEYS&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, nullKeys, nullKeys.compareTo(java.math.BigDecimal.ZERO)==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Null primary keys in QTC Storage&quot;);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#xD;&#xA;&#x9;    java.math.BigDecimal orphanOrders = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawOrders + &quot; O LEFT JOIN &quot; + rawCustomer + &quot; C ON C.\&quot;customer_id\&quot;=O.\&quot;customer_id\&quot; WHERE O.\&quot;updated_at\&quot;&lt;=TO_TIMESTAMP_NTZ(?) AND C.\&quot;customer_id\&quot; IS NULL&quot;, cutoff);&#xD;&#xA;&#x9;    h.add(&quot;ORPHAN_ORDERS&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, orphanOrders, orphanOrders.signum()==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Orders whose CUSTOMER_ID is absent&quot;);&#xD;&#xA;&#x9;    java.math.BigDecimal orphanPayments = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + rawPayments + &quot; P LEFT JOIN &quot; + rawOrders + &quot; O ON O.\&quot;order_id\&quot;=P.\&quot;order_id\&quot; WHERE P.\&quot;updated_at\&quot;&lt;=TO_TIMESTAMP_NTZ(?) AND O.\&quot;order_id\&quot; IS NULL&quot;, cutoff);&#xD;&#xA;&#x9;    h.add(&quot;ORPHAN_PAYMENTS&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, java.math.BigDecimal.ZERO, orphanPayments, orphanPayments.signum()==0?&quot;PASSED&quot;:&quot;FAILED&quot;, &quot;Payments whose ORDER_ID is absent&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;    java.math.BigDecimal mysqlOrderAmount = h.scalar(mysql, &quot;SELECT COALESCE(SUM(order_amount),0) FROM orders WHERE updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;    java.math.BigDecimal sfOrderAmount = h.scalar(sf, &quot;SELECT COALESCE(SUM(\&quot;order_amount\&quot;),0) FROM &quot; + rawOrders + &quot; WHERE \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;    h.add(&quot;ORDER_AMOUNT_TOTAL&quot;, &quot;ORDERS&quot;, &quot;CRITICAL&quot;, mysqlOrderAmount, sfOrderAmount, h.status(mysqlOrderAmount,sfOrderAmount,tolerance), &quot;MySQL versus QTC Storage order total&quot;);&#xD;&#xA;&#x9;    java.math.BigDecimal mysqlPaid = h.scalar(mysql, &quot;SELECT COALESCE(SUM(payment_amount),0) FROM payments WHERE UPPER(payment_status)='SUCCESS' AND updated_at &lt;= ?&quot;, cutoff);&#xD;&#xA;&#x9;    java.math.BigDecimal sfPaid = h.scalar(sf, &quot;SELECT COALESCE(SUM(\&quot;payment_amount\&quot;),0) FROM &quot; + rawPayments + &quot; WHERE UPPER(\&quot;payment_status\&quot;)='SUCCESS' AND \&quot;updated_at\&quot; &lt;= TO_TIMESTAMP_NTZ(?)&quot;, cutoff);&#xD;&#xA;&#x9;    h.add(&quot;SUCCESS_PAYMENT_TOTAL&quot;, &quot;PAYMENTS&quot;, &quot;CRITICAL&quot;, mysqlPaid, sfPaid, h.status(mysqlPaid,sfPaid,tolerance), &quot;MySQL versus QTC Storage successful-payment total&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;    java.math.BigDecimal overpayments = h.scalar(sf, &quot;SELECT COUNT(*) FROM (SELECT O.ORDER_ID FROM &quot; + curated + &quot;.ORDERS O JOIN &quot; + curated + &quot;.PAYMENTS P ON P.ORDER_ID=O.ORDER_ID AND UPPER(P.PAYMENT_STATUS)='SUCCESS' WHERE O.UPDATED_AT&lt;=TO_TIMESTAMP_NTZ(?) GROUP BY O.ORDER_ID HAVING SUM(P.PAYMENT_AMOUNT)>MAX(O.ORDER_AMOUNT)+&quot; + tolerance.toPlainString() + &quot;)&quot;, cutoff);&#xD;&#xA;&#x9;    h.add(&quot;OVERPAID_ORDERS&quot;, &quot;ORDER_PAYMENT_BALANCE&quot;, &quot;WARNING&quot;, java.math.BigDecimal.ZERO, overpayments, overpayments.signum()==0?&quot;PASSED&quot;:&quot;WARNING&quot;, &quot;Orders where successful payments exceed order amount&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;    java.math.BigDecimal failed = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + control + &quot;.RECONCILIATION_DETAIL WHERE RUN_ID='&quot; + runId.replace(&quot;'&quot;, &quot;''&quot;) + &quot;' AND STATUS='FAILED'&quot;, null);&#xD;&#xA;&#x9;    java.math.BigDecimal warnings = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + control + &quot;.RECONCILIATION_DETAIL WHERE RUN_ID='&quot; + runId.replace(&quot;'&quot;, &quot;''&quot;) + &quot;' AND STATUS='WARNING'&quot;, null);&#xD;&#xA;&#x9;    java.math.BigDecimal total = h.scalar(sf, &quot;SELECT COUNT(*) FROM &quot; + control + &quot;.RECONCILIATION_DETAIL WHERE RUN_ID='&quot; + runId.replace(&quot;'&quot;, &quot;''&quot;) + &quot;'&quot;, null);&#xD;&#xA;&#x9;    failedControls = failed.intValue();&#xD;&#xA;&#x9;    String overall = failed.signum()>0 ? &quot;FAILED&quot; : (warnings.signum()>0 ? &quot;PASSED_WITH_WARNINGS&quot; : &quot;PASSED&quot;);&#xD;&#xA;&#x9;    try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;UPDATE &quot; + control + &quot;.RECONCILIATION_RUN SET END_TS=CURRENT_TIMESTAMP(),STATUS=?,TOTAL_CONTROLS=?,FAILED_CONTROLS=?,WARNING_CONTROLS=? WHERE RUN_ID=?&quot;)) {&#xD;&#xA;&#x9;        ps.setString(1, overall); ps.setBigDecimal(2,total); ps.setBigDecimal(3,failed); ps.setBigDecimal(4,warnings); ps.setString(5,runId); ps.executeUpdate();&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    sf.commit();&#xD;&#xA;&#x9;    System.out.println(&quot;Reconciliation run &quot; + runId + &quot; completed with status &quot; + overall);&#xD;&#xA;&#x9;} catch (Exception e) {&#xD;&#xA;&#x9;    try { sf.rollback(); } catch (Exception ignored) {}&#xD;&#xA;&#x9;    try {&#xD;&#xA;&#x9;        sf.setAutoCommit(true);&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;INSERT INTO &quot; + control + &quot;.RECONCILIATION_RUN (RUN_ID,DQ_RUN_ID,CUTOFF_TS,ENVIRONMENT,START_TS,END_TS,STATUS,ERROR_MESSAGE) SELECT ?,?,TO_TIMESTAMP_NTZ(?),?,CURRENT_TIMESTAMP(),CURRENT_TIMESTAMP(),'ERROR',?&quot;)) {&#xD;&#xA;&#x9;            ps.setString(1,runId); ps.setString(2,context.dq_run_id); ps.setString(3,cutoff); ps.setString(4,context.environment); ps.setString(5,e.getMessage()); ps.executeUpdate();&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    } catch (Exception auditError) {&#xD;&#xA;&#x9;        System.err.println(&quot;Unable to record reconciliation error: &quot; + auditError.getMessage());&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    throw new RuntimeException(&quot;Reconciliation Job failed for run &quot; + runId, e);&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;if (failedControls > 0 &amp;&amp; java.lang.Boolean.TRUE.equals(context.fail_on_recon_error)) {&#xD;&#xA;&#x9;    throw new RuntimeException(&quot;Reconciliation produced &quot; + failedControls + &quot; critical failed controls. See &quot; + control + &quot;.RECONCILIATION_DETAIL for run &quot; + runId);&#xD;&#xA;&#x9;}"/>

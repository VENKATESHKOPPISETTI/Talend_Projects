  <node componentName="tRedshiftRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="416">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_7" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DRIVER_VERSION" value="DRIVER_V2" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;5439&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="Redshift" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:OYxBiSRK8RN/Cvw8qvUrPnmTmcqpiZze+j7HhG0t" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="USE_STRING_PROPERTIES" value="false" show="false"/>
    <elementParameter field="TABLE" name="ENTRY_PROPERTIES" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;-- Step 1: Insert new records&#xD;&#xA;&#xD;&#xA;INSERT INTO DATAMART.DIM_PRODUCTS (&#xD;&#xA;    PRODUCT_BUSINESS_ID,&#xD;&#xA;    PRODUCT_NAME,&#xD;&#xA;    PRICE,&#xD;&#xA;    START_DATE,&#xD;&#xA;    END_DATE,&#xD;&#xA;    ACTIVE_STATUS,&#xD;&#xA;    VERSION&#xD;&#xA;)&#xD;&#xA;SELECT&#xD;&#xA;&#x9;STG.PRODUCT_BUSINESS_ID,&#xD;&#xA;    STG.PRODUCT_NAME,&#xD;&#xA;    STG.PRICE,&#xD;&#xA;    CURRENT_TIMESTAMP AS START_DATE,&#xD;&#xA;    NULL AS END_DATE,&#xD;&#xA;    1 AS ACTIVE_STATUS,  -- Set active status to 1 for new records&#xD;&#xA;    1 AS VERSION  -- Initial version&#xD;&#xA;FROM&#xD;&#xA;    STAGING.STG_PRODUCTS STG&#xD;&#xA;LEFT JOIN&#xD;&#xA;   DATAMART.DIM_PRODUCTS DIM&#xD;&#xA;ON&#xD;&#xA;    STG.PRODUCT_BUSINESS_ID = DIM.PRODUCT_BUSINESS_ID&#xD;&#xA;WHERE&#xD;&#xA;    DIM.PRODUCT_BUSINESS_ID IS NULL;&#xD;&#xA;   &#xD;&#xA;   &#xD;&#xA;-- Step 2: Update existing records&#xD;&#xA;   &#xD;&#xA;UPDATE DATAMART.DIM_PRODUCTS&#xD;&#xA;SET END_DATE = CURRENT_TIMESTAMP&#xD;&#xA;FROM STAGING.STG_PRODUCTS AS b&#xD;&#xA;WHERE DATAMART.DIM_PRODUCTS.PRODUCT_BUSINESS_ID = b.PRODUCT_BUSINESS_ID&#xD;&#xA;    AND (CAST(DATAMART.DIM_PRODUCTS.PRODUCT_NAME AS varchar(255)) &lt;> CAST(b.PRODUCT_NAME AS varchar(255)) OR DATAMART.DIM_PRODUCTS.PRICE &lt;> b.PRICE)&#xD;&#xA;    AND DATAMART.DIM_PRODUCTS.ACTIVE_STATUS = 1&#xD;&#xA;    AND DATAMART.DIM_PRODUCTS.END_DATE IS NULL;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;-- Step 3: Insert new version records for updated data&#xD;&#xA;   &#xD;&#xA;INSERT INTO DATAMART.DIM_PRODUCTS (PRODUCT_BUSINESS_ID, PRODUCT_NAME, PRICE, START_DATE, END_DATE, ACTIVE_STATUS, VERSION)&#xD;&#xA;SELECT&#xD;&#xA;    STG.PRODUCT_BUSINESS_ID,&#xD;&#xA;    STG.PRODUCT_NAME,&#xD;&#xA;    STG.PRICE,&#xD;&#xA;    CURRENT_TIMESTAMP AS START_DATE,&#xD;&#xA;    NULL AS END_DATE,&#xD;&#xA;    1 AS ACTIVE_STATUS,&#xD;&#xA;    OLD_DIM.VERSION + 1 AS VERSION&#xD;&#xA;FROM&#xD;&#xA;   &#x9;&#x9;STAGING.STG_PRODUCTS STG&#xD;&#xA;JOIN&#xD;&#xA;    &#x9;DATAMART.DIM_PRODUCTS OLD_DIM&#xD;&#xA;ON&#xD;&#xA;&#x9;&#x9;STG.PRODUCT_BUSINESS_ID = OLD_DIM.PRODUCT_BUSINESS_ID   &#xD;&#xA;WHERE &#x9;   &#xD;&#xA;&#x9;&#x9;(CAST(OLD_DIM.PRODUCT_NAME AS varchar(255)) &lt;> CAST(STG.PRODUCT_NAME AS varchar(255)) &#xD;&#xA;OR &#x9;&#x9;OLD_DIM.PRICE &lt;> STG.PRICE)&#xD;&#xA;AND &#x9;OLD_DIM.ACTIVE_STATUS = 1&#xD;&#xA;AND&#x9;&#x9;OLD_DIM.END_DATE IS NOT NULL;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;-- Step 4: Update Active_Status to 0 for old record&#xD;&#xA;&#xD;&#xA;UPDATE DATAMART.DIM_PRODUCTS&#xD;&#xA;SET&#xD;&#xA;    ACTIVE_STATUS = 0&#xD;&#xA;WHERE&#xD;&#xA;    END_DATE IS NOT NULL&#xD;&#xA;AND ACTIVE_STATUS = 1&#xD;&#xA;;&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="COLUMN_LIST" name="RECORD_SET_COLUMN" value="" show="false"/>
    <elementParameter field="CHECK" name="USE_PREPAREDSTATEMENT" value="false"/>
    <elementParameter field="TABLE" name="SET_PREPAREDSTATEMENT_PARAMETERS" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="TEXT" name="COMMIT_EVERY" value="10000" show="false"/>
    <elementParameter field="CLOSED_LIST" name="JDBC_URL" value="STANDARD" show="false"/>
    <elementParameter field="TEXT" name="LABEL" value="&lt;b>__UNIQUE_NAME__&lt;/b>&lt;br>DIM_PRODUCTS"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBRow_7"/>
    <metadata connector="REJECT" name="REJECT">
      <column defaultValue="" key="false" length="255" name="errorCode" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column defaultValue="" key="false" length="255" name="errorMessage" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>

    <elementParameter field="MEMO_JAVA" name="CODE" value="/**&#10;*&#9;set drop zone layer code&#10;*&#9;usefule for:&#10;*&#9;&#9;1) identifying right source tables to import into dropzone&#10;*&#9;&#9;2) audit logging&#10;*/&#10;&#10;String LAYER_KEY = &quot;LAYER&quot;;&#10;String LAYER_VALUE =  &quot;SQ&quot;;&#9;// dropzone code - defined in metadata tables&#10;&#10;globalMap.put(LAYER_KEY, LAYER_VALUE);&#10;&#10;&#10;//Prepare the query to get run date from sc_execution_run_date table&#10;&#10;//String fetch_run_date_qry = &quot;SELECT MAX(RUN_DATE) from SUPPLY_CHAIN_JOB_RUN_DATE&quot;;&#10;&#10;//globalMap.put(&quot;RUN_DATE_QRY&quot;, fetch_run_date_qry);&#10;context.sc_execution_table_id = 1;&#10;context.table_id =1;&#10;Date currentDate = TalendDate.getCurrentDate();&#10;String pattern = &quot;yyyyMMddHHmmss&quot;;&#10;SimpleDateFormat sdf = new SimpleDateFormat(pattern);&#10;String formated_date = sdf.format(currentDate);&#10;&#10; &#10;&#10;context.sc_execution_run_date = Long.valueOf(formated_date);&#10;&#10; &#10;&#10;System.out.println(&quot;Execution Run Date:&quot;+ context.sc_execution_run_date);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>

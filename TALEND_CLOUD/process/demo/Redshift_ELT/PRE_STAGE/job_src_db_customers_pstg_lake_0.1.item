    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#13;&#10;&#10;String latest_file_path = input_row.abs_path;&#10;&#10;int index_value = StringHandling.INDEX(input_row.basename,&quot;_&quot;);&#10;&#10;&#10;String latest_file_name = StringHandling.SUBSTR(input_row.basename, 0, index_value);&#10;&#10;&#10;&#10;globalMap.put(&quot;latest_file_path&quot;, latest_file_path);&#10;&#10;globalMap.put(&quot;latest_file_name&quot;, latest_file_name);&#10;&#10;&#10;//System.out.println(&quot;The file path: &quot;+((String)globalMap.get(&quot;latest_file_path&quot;)));&#10;&#10;//System.out.println(&quot;The file name: &quot;+((String)globalMap.get(&quot;latest_file_name&quot;)));&#10;&#10;&#13;&#10;"/>

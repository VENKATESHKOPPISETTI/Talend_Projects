    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO STAGING.SALES_STG (DATE,CUSTOMER_ID, COUNTRY_ID, PRODUCT_ID_HISTO, TOTAL_SALES)&#13;&#10;SELECT&#13;&#10;    cast(e.EVENT_TIME AS DATE) AS DATE,&#13;&#10;    c.CUSTOMER_ID,&#13;&#10;    COALESCE(d.COUNTRY_ID, -1) AS COUNTRY_ID,&#13;&#10;    p.PRODUCT_ID_HISTO,&#13;&#10;    SUM(p.PRICE) AS TOTAL_SALES&#13;&#10;FROM&#13;&#10;    STAGING.TRX_EVENTS e&#13;&#10;LEFT JOIN&#13;&#10;    DATAMART.DIM_CUSTOMERS c ON e.CUSTOMER_BUSINESS_ID = c.CUSTOMER_BUSINESS_ID&#13;&#10;LEFT JOIN&#13;&#10;    DATAMART.DIM_COUNTRIES d ON c.COUNTRY_CODE = d.COUNTRY_CODE&#13;&#10;LEFT JOIN&#13;&#10;    DATAMART.DIM_PRODUCTS p ON e.PRODUCT_BUSINESS_ID = p.PRODUCT_BUSINESS_ID&#13;&#10;WHERE&#13;&#10;    p.ACTIVE_STATUS = 1&#13;&#10;GROUP BY&#13;&#10;    e.EVENT_TIME,&#13;&#10;    c.CUSTOMER_ID,&#13;&#10;    COALESCE(d.COUNTRY_ID, -1),&#13;&#10;    p.PRODUCT_ID_HISTO;&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="false"/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="COLUMN_LIST" name="RECORD_SET_COLUMN" show="false" value=""/>
    <elementParameter field="CHECK" name="USE_PREPAREDSTATEMENT" value="false"/>
    <elementParameter field="TABLE" name="SET_PREPAREDSTATEMENT_PARAMETERS" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" show="false" value="&quot;ISO-8859-15&quot;"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="TEXT" name="COMMIT_EVERY" show="false" value="10000"/>
    <elementParameter field="CLOSED_LIST" name="JDBC_URL" show="false" value="STANDARD"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBRow_1"/>

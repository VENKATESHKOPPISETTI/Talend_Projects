    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;-- Step 2: Update existing records&#13;&#10;   &#13;&#10;UPDATE DATAMART.DIM_PRODUCTS DIM&#13;&#10;SET&#13;&#10;    END_DATE = CURRENT_TIMESTAMP,&#13;&#10;    ACTIVE_STATUS = 0  -- Set active status to 0 for old records&#13;&#10;FROM&#13;&#10;    STAGING.STG_PRODUCTS STG&#13;&#10;WHERE&#13;&#10;    DIM.PRODUCT_BUSINESS_ID = STG.PRODUCT_BUSINESS_ID&#13;&#10;AND&#13;&#10;    DIM.END_DATE IS NULL&#13;&#10;AND&#13;&#10;   (DIM.PRODUCT_NAME &lt;&gt; STG.PRODUCT_NAME&#13;&#10;    OR DIM.PRICE &lt;&gt; STG.PRICE);&#13;&#10;&#13;&#10;&#13;&#10;-- Step 3: Insert new version records for updated data&#13;&#10;   &#13;&#10;INSERT INTO DATAMART.DIM_PRODUCTS (PRODUCT_BUSINESS_ID, PRODUCT_NAME, PRICE, START_DATE, END_DATE, ACTIVE_STATUS, VERSION)&#13;&#10;SELECT&#13;&#10;    STG.PRODUCT_BUSINESS_ID,&#13;&#10;    STG.PRODUCT_NAME,&#13;&#10;    STG.PRICE,&#13;&#10;    CURRENT_TIMESTAMP AS START_DATE,&#13;&#10;    NULL AS END_DATE,&#13;&#10;    1 AS ACTIVE_STATUS,&#13;&#10;    OLD_DIM.VERSION + 1 AS VERSION&#13;&#10;FROM&#13;&#10;   &#9;&#9;&#9;STAGING.STG_PRODUCTS STG&#13;&#10;JOIN&#13;&#10;    &#9;&#9;DATAMART.DIM_PRODUCTS OLD_DIM&#13;&#10;ON&#13;&#10;&#9;&#9;&#9;STG.PRODUCT_BUSINESS_ID = OLD_DIM.PRODUCT_BUSINESS_ID   &#13;&#10;WHERE &#9;   &#13;&#10;&#9;&#9;&#9;OLD_DIM.PRODUCT_NAME &lt;&gt; STG.PRODUCT_NAME&#13;&#10;OR &#9;&#9;OLD_DIM.PRICE &lt;&gt; STG.PRICE;&quot;"/>

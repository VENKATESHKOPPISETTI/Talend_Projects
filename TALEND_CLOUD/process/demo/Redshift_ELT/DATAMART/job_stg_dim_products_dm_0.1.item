    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO DATAMART.DIM_PRODUCTS (&#13;&#10;    PRODUCT_BUSINESS_ID,&#13;&#10;    PRODUCT_NAME,&#13;&#10;    PRICE,&#13;&#10;    START_DATE,&#13;&#10;    END_DATE,&#13;&#10;    ACTIVE_STATUS,&#13;&#10;    VERSION&#13;&#10;)&#13;&#10;SELECT&#13;&#10;&#9;STG.PRODUCT_BUSINESS_ID,&#13;&#10;    STG.PRODUCT_NAME,&#13;&#10;    STG.PRICE,&#13;&#10;    CURRENT_TIMESTAMP AS START_DATE,&#13;&#10;    NULL AS END_DATE,&#13;&#10;    1 AS ACTIVE_STATUS,  -- Set active status to 1 for new records&#13;&#10;    1 AS VERSION  -- Initial version&#13;&#10;FROM&#13;&#10;    STAGING.STG_PRODUCTS STG&#13;&#10;LEFT JOIN&#13;&#10;    DATAMART.DIM_PRODUCTS DIM&#13;&#10;ON&#13;&#10;    STG.PRODUCT_BUSINESS_ID = DIM.PRODUCT_BUSINESS_ID&#13;&#10;WHERE&#13;&#10;    DIM.PRODUCT_BUSINESS_ID IS NULL;&quot;"/>

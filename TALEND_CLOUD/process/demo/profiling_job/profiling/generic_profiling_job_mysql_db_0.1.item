  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1800" posY="520">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xA;output_row.table_name = input_row.table_name;&#xD;&#xA;output_row.total_rows = input_row.total_rows;&#xD;&#xA;output_row.column_count = input_row.column_count;&#xA;&#xA;//Extracting column name from fields list based on sequence and index&#xD;&#xA;output_row.field_name = input_row.fields_list.split(&quot;,&quot;)[Numeric.sequence(input_row.table_name, 0, 1)];&#xA;&#xA;//Code generated according to input schema and output schema&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;output_row.total_rows_with_values = input_row.total_rows_with_values;&#xD;&#xA;output_row.count_of_distinct_values = input_row.count_of_distinct_values;&#xA;&#xA;//Extracting only first 10 comma separated distinct values from list &#xD;&#xA;output_row.top_10_distinct_values = ((input_row.distinct_values_list == null || &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;input_row.distinct_values_list.isEmpty()) ? null : &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;input_row.distinct_values_list.replaceFirst(&quot;(([^,]+,){0,9}[^,]+).*&quot;, &quot;$1&quot;)); &#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="limiting_splitting_values"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="table_name" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="total_rows" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="column_count" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="field_name" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="total_rows_with_values" nullable="true" pattern="&quot;dd-MM-yyyy&quot;" precision="-1" sourceType="VARCHAR" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="count_of_distinct_values" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="top_10_distinct_values" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>

  <node componentName="tMysqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="1440" posY="520">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_2" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MYSQL_8" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;192.168.1.104&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;3306&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;venkateshk&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MySQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;venkateshk&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:wlZSA/p77oc64eBNrLMqy8yciLq1JjuBktoR6pXC2OKcVT+OIhXz" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value=""/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT&#xD;&#xA;    '&quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;' AS table_name,&#xD;&#xA;    (SELECT COUNT(*) FROM &quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;) AS total_rows,&#xD;&#xA;    (SELECT COUNT(column_name) FROM information_schema.columns WHERE table_schema = '&quot;+ context.Mysql_connection_source_Database+&quot;'&#xD;&#xA;                       AND table_name = '&quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;') AS column_count,&#xD;&#xA;    (SELECT GROUP_CONCAT(column_name, '') FROM information_schema.columns WHERE table_schema = '&quot;+ context.Mysql_connection_source_Database+&quot;'&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  AND table_name = '&quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;') AS fields_list,&#xD;&#xA;    COUNT(&quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot;) AS total_rows_with_values,&#xD;&#xA;    COUNT(DISTINCT &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot;) AS count_of_distinct_values,&#xD;&#xA;    GROUP_CONCAT(DISTINCT &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot; ORDER BY &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot; ASC) AS distinct_values_list&#xD;&#xA;FROM &quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;&quot;&#xD;&#xA;&#xD;&#xA;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" value="mysql_id" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;noDatetimeString=true&quot;" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="CHECK" name="ENABLE_STREAM" value="false"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <elementParameter field="TABLE" name="TRIM_COLUMN">
      <elementValue elementRef="SCHEMA_COLUMN" value="table_name" id="0"/>
      <elementValue elementRef="TRIM" value="false" id="1"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="total_rows" id="2"/>
      <elementValue elementRef="TRIM" value="false" id="3"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="column_count" id="4"/>
      <elementValue elementRef="TRIM" value="false" id="5"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="fields_list" id="6"/>
      <elementValue elementRef="TRIM" value="false" id="7"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="total_rows_with_values" id="8"/>
      <elementValue elementRef="TRIM" value="false" id="9"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="count_of_distinct_values" id="10"/>
      <elementValue elementRef="TRIM" value="false" id="11"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="distinct_values_list" id="12"/>
      <elementValue elementRef="TRIM" value="false" id="13"/>
    </elementParameter>
    <elementParameter field="TEXT" name="LABEL" value="sql_query"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_2">
      <column comment="" key="false" length="-1" name="table_name" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_String" originalLength="-1" usefulColumn="true"/>

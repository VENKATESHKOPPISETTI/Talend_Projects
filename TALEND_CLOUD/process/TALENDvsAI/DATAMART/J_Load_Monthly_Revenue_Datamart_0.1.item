    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;&#xD;&#xA;SELECT d.year_no,&#xD;&#xA; d.month_no, &#xD;&#xA;d.month_name, &#xD;&#xA;SUM(p.amount), &#xD;&#xA;COUNT(*), &#xD;&#xA;MAX(p.batch_id), &#xD;&#xA;CURRENT_TIMESTAMP &#xD;&#xA;FROM dw.fact_payment p &#xD;&#xA;JOIN dw.dim_date d &#xD;&#xA;ON p.payment_date_key=d.date_key &#xD;&#xA;GROUP BY d.year_no, d.month_no, d.month_name;&#xD;&#xA;&quot;"/>

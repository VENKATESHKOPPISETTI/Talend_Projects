  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="440" posY="360">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;//context.max_batch_id = input_row.max_batch_id;&#xD;&#xA;&#xD;&#xA;context.max_last_update = input_row.max_last_update;&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;max_last_update: &quot;+context.max_last_update);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;Long maxBatch = input_row.max_batch_id;&#xD;&#xA;&#xD;&#xA;String today = TalendDate.formatDate(&quot;yyyyMMdd&quot;, TalendDate.getCurrentDate());&#xD;&#xA; &#xD;&#xA;String batchId;&#xD;&#xA; &#xD;&#xA;if(maxBatch == null || maxBatch == 0){&#xD;&#xA;    batchId = today + &quot;001&quot;;&#xD;&#xA;}&#xD;&#xA;else{&#xD;&#xA; &#xD;&#xA;    String maxBatchStr = String.valueOf(maxBatch);&#xD;&#xA; &#xD;&#xA;    String lastDate = maxBatchStr.substring(0,8);&#xD;&#xA; &#xD;&#xA;    int batchNo = Integer.parseInt(maxBatchStr.substring(8));&#xD;&#xA; &#xD;&#xA;    if(lastDate.equals(today)){&#xD;&#xA;        batchNo++;&#xD;&#xA;    }else{&#xD;&#xA;        batchNo = 1;&#xD;&#xA;    }&#xD;&#xA; &#xD;&#xA;    batchId = today + String.format(&quot;%03d&quot;, batchNo);&#xD;&#xA;}&#xD;&#xA; &#xD;&#xA;context.batch_id = batchId;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;batch_id: &quot;+context.batch_id);&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="max_batch_id" nullable="true" pattern="" precision="-1" sourceType="INT8" type="id_Long" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="max_last_update" nullable="true" pattern="&quot;yyyy-MM-dd HH:mm:ss&quot;" precision="-1" sourceType="TIMESTAMP" type="id_Date" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>

    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT DISTINCT&#xD;&#xA;TO_CHAR(dt,'YYYYMMDD')::INTEGER,&#xD;&#xA;dt,&#xD;&#xA;EXTRACT(DAY FROM dt),&#xD;&#xA;EXTRACT(MONTH FROM dt),&#xD;&#xA;TO_CHAR(dt,'Month'),&#xD;&#xA;EXTRACT(QUARTER FROM dt),&#xD;&#xA;EXTRACT(YEAR FROM dt),&#xD;&#xA;TO_CHAR(dt,'Day')&#xD;&#xA;FROM&#xD;&#xA;(&#xD;&#xA;   SELECT create_date::DATE dt&#xD;&#xA;   FROM staging.customer&#xD;&#xA;   UNION&#xD;&#xA;   SELECT rental_date::DATE&#xD;&#xA;   FROM staging.rental&#xD;&#xA;   UNION&#xD;&#xA;   SELECT return_date::DATE&#xD;&#xA;   FROM staging.rental&#xD;&#xA;   WHERE return_date IS NOT NULL&#xD;&#xA;   UNION&#xD;&#xA;   SELECT payment_date::DATE&#xD;&#xA;   FROM staging.payment&#xD;&#xA;) d&#xD;&#xA;&quot;&#xD;&#xA;"/>

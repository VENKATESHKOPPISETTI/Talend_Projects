  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1760" posY="400">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xD;&#xA;context.FILE_DIRECTORY = input_row.dirname;&#xD;&#xA;context.FILE_NAME = input_row.basename;&#xA;context.FILE_SIZE_KB = (BigDecimal.valueOf(input_row.size / 1024.00)).setScale(2,RoundingMode.HALF_UP);&#xD;&#xA;context.FILE_SIZE_MB = (BigDecimal.valueOf(input_row.size / (1048576.00))).setScale(4,RoundingMode.HALF_UP);&#xA;context.FILE_SIZE_GB = (BigDecimal.valueOf(input_row.size / (1073741824.00))).setScale(7,RoundingMode.HALF_UP);&#xD;&#xA;&#xD;&#xA;//context.DATE = TalendDate.formatDate(&quot;yyyy-MM-dd HH:mm:ss&quot;,TalendDate.parseDate(&quot;EEE MMM dd HH:mm:ss zzz yyyy&quot;,input_row.mtime_string));&#xA;&#xA;// (BigDecimal.valueOf(input_row.size / (1024.00 * 1024.00))).setScale(4,BigDecimal.ROUND_HALF_UP) 1,073,741,824&#xD;&#xA;&#xD;&#xA;//===============================&#xD;&#xA;//FILE MODIFIED DATE&#xD;&#xA;//===============================&#xD;&#xA;&#xD;&#xA;String mtime = input_row.mtime_string;&#xD;&#xA;&#xD;&#xA;if (mtime != null &amp;&amp; !mtime.trim().isEmpty()) {&#xD;&#xA;&#xD;&#xA; // Convert IST to explicit India Standard Time offset&#xD;&#xA; mtime = mtime.replace(&quot; IST &quot;, &quot; +0530 &quot;);&#xD;&#xA;&#xD;&#xA; java.text.SimpleDateFormat inputFormat =&#xD;&#xA;     new java.text.SimpleDateFormat(&#xD;&#xA;         &quot;EEE MMM dd HH:mm:ss Z yyyy&quot;,&#xD;&#xA;         java.util.Locale.ENGLISH&#xD;&#xA;     );&#xD;&#xA;&#xD;&#xA; java.text.SimpleDateFormat outputFormat =&#xD;&#xA;     new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);&#xD;&#xA;&#xD;&#xA; java.util.Date parsedDate = inputFormat.parse(mtime);&#xD;&#xA;&#xD;&#xA; context.DATE = outputFormat.format(parsedDate);&#xD;&#xA;&#xD;&#xA;} else {&#xD;&#xA; context.DATE = null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xA;&#xA;&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import java.math.RoundingMode;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column defaultValue="" key="false" length="255" name="abs_path" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column defaultValue="" key="false" length="255" name="dirname" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column defaultValue="" key="false" length="255" name="basename" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column defaultValue="" key="false" length="10" name="mode_string" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column defaultValue="" key="false" length="20" name="size" nullable="true" precision="0" sourceType="" type="id_Long" originalLength="-1" usefulColumn="true"/>
      <column defaultValue="" key="false" length="20" name="mtime" nullable="true" precision="0" sourceType="" type="id_Long" originalLength="-1" usefulColumn="true"/>
      <column defaultValue="" key="false" length="20" name="mtime_string" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>

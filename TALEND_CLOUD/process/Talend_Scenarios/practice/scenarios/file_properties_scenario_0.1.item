  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1408" posY="320">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#13;&#10;context.FILE_DIRECTORY = input_row.dirname;&#13;&#10;context.FILE_NAME = input_row.basename;&#10;context.FILE_SIZE_KB = (BigDecimal.valueOf(input_row.size / 1024.00)).setScale(2,BigDecimal.ROUND_HALF_UP);&#13;&#10;context.FILE_SIZE_MB = (BigDecimal.valueOf(input_row.size / (1048576.00))).setScale(4,BigDecimal.ROUND_HALF_UP);&#10;context.FILE_SIZE_GB = (BigDecimal.valueOf(input_row.size / (1073741824.00))).setScale(7,BigDecimal.ROUND_HALF_UP);&#13;&#10;context.DATE = TalendDate.formatDate(&quot;yyyy-MM-dd HH:mm:ss&quot;,TalendDate.parseDate(&quot;EEE MMM dd HH:mm:ss zzz yyyy&quot;,input_row.mtime_string));&#10;&#10;// (BigDecimal.valueOf(input_row.size / (1024.00 * 1024.00))).setScale(4,BigDecimal.ROUND_HALF_UP) 1,073,741,824&#10;&#10;&#13;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column defaultValue="" key="false" length="255" name="abs_path" nullable="true" originalLength="-1" precision="0" sourceType="" type="id_String" usefulColumn="true"/>
      <column defaultValue="" key="false" length="255" name="dirname" nullable="true" originalLength="-1" precision="0" sourceType="" type="id_String" usefulColumn="true"/>
      <column defaultValue="" key="false" length="255" name="basename" nullable="true" originalLength="-1" precision="0" sourceType="" type="id_String" usefulColumn="true"/>
      <column defaultValue="" key="false" length="10" name="mode_string" nullable="true" originalLength="-1" precision="0" sourceType="" type="id_String" usefulColumn="true"/>
      <column defaultValue="" key="false" length="20" name="size" nullable="true" originalLength="-1" precision="0" sourceType="" type="id_Long" usefulColumn="true"/>
      <column defaultValue="" key="false" length="20" name="mtime" nullable="true" originalLength="-1" precision="0" sourceType="" type="id_Long" usefulColumn="true"/>
      <column defaultValue="" key="false" length="20" name="mtime_string" nullable="true" originalLength="-1" precision="0" sourceType="" type="id_String" usefulColumn="true"/>

    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT&#13;&#10;    '&quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;' AS table_name,&#13;&#10;    (SELECT COUNT(*) FROM &quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;) AS total_rows,&#13;&#10;    (SELECT COUNT(column_name) FROM information_schema.columns WHERE table_name = '&quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;') AS column_count,&#13;&#10;    (SELECT GROUP_CONCAT(column_name, '') FROM information_schema.columns WHERE table_name = '&quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;') AS fields_list,&#13;&#10;    COUNT(&quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot;) AS total_rows_with_values,&#13;&#10;    COUNT(DISTINCT &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot;) AS count_of_distinct_values,&#13;&#10;    GROUP_CONCAT(DISTINCT &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot; ORDER BY &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot; ASC) AS distinct_values_list&#13;&#10;FROM &quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;;&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;"/>
    <elementParameter field="LABEL" name="NOTE" show="false" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" show="false" value="false"/>

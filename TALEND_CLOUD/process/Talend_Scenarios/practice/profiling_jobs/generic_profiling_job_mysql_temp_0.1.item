  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1568" posY="288">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#10;output_row.table_name = input_row.table_name;&#13;&#10;output_row.total_rows = input_row.total_rows;&#13;&#10;output_row.column_count = input_row.column_count;&#10;&#10;//Extracting column name from fields list based on sequence and index&#13;&#10;output_row.field_name = input_row.fields_list.split(&quot;,&quot;)[Numeric.sequence(input_row.table_name, 0, 1)];&#10;&#10;//Code generated according to input schema and output schema&#9;&#9;&#9;&#9;&#9;&#9;&#10;output_row.total_rows_with_values = input_row.total_rows_with_values;&#13;&#10;output_row.count_of_distinct_values = input_row.count_of_distinct_values;&#10;&#10;//Extracting only first 10 comma separated distinct values from list &#13;&#10;output_row.top_10_distinct_values = ((input_row.distinct_values_list == null || &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;input_row.distinct_values_list.isEmpty()) ? null : &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;input_row.distinct_values_list.replaceFirst(&quot;(([^,]+,){0,9}[^,]+).*&quot;, &quot;$1&quot;)); &#10;&#10;//Storing table_names as Sequence_Identifier on global variable to reset the sequence&#10;globalMap.put(&quot;Sequence_Identifier&quot;, input_row.table_name);&#10;&#10;&#10;&#13;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="limiting_splitting_values"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>

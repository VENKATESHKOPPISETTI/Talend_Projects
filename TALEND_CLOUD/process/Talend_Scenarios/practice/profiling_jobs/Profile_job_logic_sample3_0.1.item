    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;WITH ColumnCounts AS (&#13;&#10;    SELECT&#13;&#10;        table_name,&#13;&#10;        COUNT(*) AS column_count&#13;&#10;    FROM information_schema.columns&#13;&#10;    WHERE lower(table_name) = '&quot;+((String)globalMap.get(&quot;row1.value&quot;))+&quot;'&#13;&#10;    GROUP BY table_name&#13;&#10;)&#13;&#10;&#13;&#10;SELECT&#13;&#10;    (SELECT COUNT(*) FROM &quot;+((String)globalMap.get(&quot;row1.value&quot;))+&quot;) AS row_count,&#13;&#10;&#9;table_name,&#13;&#10;    column_count&#13;&#10;FROM ColumnCounts;&#13;&#10;&#13;&#10;&#13;&#10;SELECT &#13;&#10;      STRING_AGG(column_name,', ') AS column_list&#13;&#10;FROM information_schema.columns&#13;&#10;WHERE table_name = '&quot;+((String)globalMap.get(&quot;row1.value&quot;))+&quot;';&#13;&#10;&#13;&#10;&#13;&#10;DECLARE @DynamicSQL NVARCHAR(MAX)&#13;&#10;&#13;&#10;SET @DynamicSQL = &#13;&#10;    'SELECT ' + &#13;&#10;    (&#13;&#10;        SELECT &#13;&#10;            STRING_AGG(&#13;&#10;                'CAST(COUNT(DISTINCT ' + QUOTENAME(column_name) + ') AS NVARCHAR(MAX))',&#13;&#10;                ' + '' , '' + ' &#13;&#10;            )&#13;&#10;        FROM information_schema.columns&#13;&#10;        WHERE table_name = '&quot;+((String)globalMap.get(&quot;row1.value&quot;))+&quot;'&#13;&#10;    ) + &#13;&#10;    ' AS all_columns_distinct_counts FROM &quot;+((String)globalMap.get(&quot;row1.value&quot;))+&quot;'&#13;&#10;&#13;&#10;EXEC sp_executesql @DynamicSQL;&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;"/>

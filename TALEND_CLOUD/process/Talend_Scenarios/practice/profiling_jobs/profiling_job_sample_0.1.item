    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;WITH DistinctValues AS (&#13;&#10;    SELECT  &#13;&#10;        &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot; AS count_column_value&#13;&#10;    FROM &quot;+ ((String)globalMap.get(&quot;row6.value&quot;)) +&quot;&#13;&#10;),&#13;&#10;Values_List AS &#13;&#10;(&#13;&#10;    SELECT  STRING_AGG(CAST(count_column_value AS VARCHAR(MAX)), ',') AS value_list&#13;&#10;    FROM (&#13;&#10;        &#9;&#9;SELECT DISTINCT count_column_value&#13;&#10;        &#9;&#9;FROM DistinctValues&#13;&#10;   &#9;&#9;&#9;&#9; ) AS subquery&#13;&#10;),&#13;&#10;Columns_List AS&#13;&#10;(&#13;&#10;&#9;SELECT &#13;&#10;&#9;&#9;&#9;&#9;&#9;COUNT(column_name) AS column_count,&#13;&#10;      &#9;&#9;&#9;&#9;STRING_AGG(column_name,', ') AS column_list&#13;&#10;&#9;FROM information_schema.columns&#13;&#10;&#9;WHERE table_name = '&quot;+((String)globalMap.get(&quot;row6.value&quot;))+&quot;'&#13;&#10;)&#13;&#10;SELECT &#13;&#10;&#9;('&quot;+ ((String)globalMap.get(&quot;row6.value&quot;)) +&quot;') AS tablename,&#13;&#10;&#9;COUNT(count_column_value) AS row_count,&#13;&#10;    (SELECT column_count FROM Columns_List)AS column_count,&#13;&#10;    (SELECT column_list FROM Columns_List) AS column_list, &#13;&#10;    COUNT(count_column_value) AS column_values_count,&#13;&#10;    COUNT(DISTINCT count_column_value) AS column_distinct_values_count,&#13;&#10;    (SELECT value_list FROM Values_List) AS distinct_value_list&#13;&#10;FROM DistinctValues;&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;"/>
    <elementParameter field="LABEL" name="NOTE" show="false" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" show="false" value="false"/>

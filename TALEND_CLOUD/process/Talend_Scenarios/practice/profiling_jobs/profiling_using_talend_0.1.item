    <elementParameter field="CHECK" name="ACTIVATE" value="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="STRING_AGG( CAST(Project_Name AS VARCHAR(MAX)), ',')&#10;&#10;select string_agg(cast(column_name AS VARCHAR(MAX)), ',')&#10;from information_schema.columns&#10;where table_name = 'cust_scd1';&#10;&#10;&#10;select string_agg(column_name, ',') as columns_list&#10;from information_schema.columns&#10;where table_name = 'cust_scd1';&#10;&#10;select string_agg(cast(first_name as varchar(max)), ',') as value_list from cust_scd1;&#10;&#10;&#10;SELECT STRING_AGG(CAST(first_name AS VARCHAR(MAX)), ',') AS value_list&#10;FROM (&#10;    SELECT DISTINCT first_name&#10;    FROM cust_scd1&#10;) AS subquery;&#10;&#10;&#10;&#10;&#10;&#10;WITH DistinctValues AS (&#10;    SELECT DISTINCT &#10;        &quot;+((Dynamic)globalMap.get(&quot;row1.newColumn&quot;))+&quot; AS distinct_column_value&#10;    FROM &quot;+ ((String)globalMap.get(&quot;row6.value&quot;)) +&quot;&#10;)&#10;&#10;SELECT &#10;    COUNT(distinct_column_value) AS column_values_count,&#10;    COUNT(*) AS column_distinct_values_count,&#10;    STRING_AGG(CAST(distinct_column_value AS VARCHAR(MAX)), ',') AS value_list&#10;FROM DistinctValues;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_4"/>
  </node>

  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1216" posY="32">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_2"/>
    <elementParameter field="CHECK" name="ACTIVATE" value="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="String emailContent = input_row.emailContent; // Assuming emailContent is the field containing the email content&#10;&#10;// Extracting From, To, and Subject using regular expressions&#10;String from = extractField(emailContent, &quot;From: (.*?)\\n&quot;);&#10;String to = extractField(emailContent, &quot;To: (.*?)\\n&quot;);&#10;String subject = extractField(emailContent, &quot;Subject: (.*?)\\n&quot;);&#10;&#10;output_row.from = from;&#10;output_row.to = to;&#10;output_row.subject = subject;&#10;&#10;// Function to extract a field using a regular expression&#10;private String extractField(String input, String regex) {&#10;    java.util.regex.Pattern pattern = java.util.regex.Pattern.compile(regex);&#10;    java.util.regex.Matcher matcher = pattern.matcher(input);&#10;    if (matcher.find()) {&#10;        return matcher.group(1);&#10;    } else {&#10;        return null;&#10;    }&#10;}&#10;&#10;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_2"/>
  </node>

    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#13;&#10;output_row.token = input_row.token;&#13;&#10;output_row.instance_url = input_row.instance_url;&#10;&#10;context.token=output_row.token;&#10;context.instance_url = output_row.instance_url;&#10;&#10;&#10;System.out.println(&quot;OAuth Token: &quot;+input_row.token);&#10;&#10;&#13;&#10;System.out.println(&quot;Instance URL: &quot;+input_row.instance_url);"/>

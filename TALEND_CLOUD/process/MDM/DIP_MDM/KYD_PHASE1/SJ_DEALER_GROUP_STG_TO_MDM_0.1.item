    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true"/>
      <outputTables sizeState="INTERMEDIATE" name="stage_link">
        <mapperTableEntries name="id" expression="relink_dg.id" type="id_Long"/>
        <mapperTableEntries name="company_guid" expression="lkp_company2.company_guid" type="id_String" nullable="true"/>
        <mapperTableEntries name="dealer_group_guid" expression="lkp_group2.dealer_group_guid" type="id_String" nullable="true"/>
        <mapperTableEntries name="dq_status" expression="lkp_company2.company_guid == null ? &quot;PENDING_PARENT&quot; : &quot;VALID&quot;" type="id_String"/>
        <mapperTableEntries name="dq_reason" expression="lkp_company2.company_guid == null ? &quot;COMPANY_NOT_FOUND&quot; : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="mdm_action" expression="lkp_group2.dealer_group_guid == null ? relink_dg.mdm_action : (relink_dg.dedup_rank != null &amp;&amp; relink_dg.dedup_rank > 1 ? &quot;DUPLICATE_REUSED&quot; : relink_dg.mdm_action)" type="id_String" nullable="true"/>
        <mapperTableEntries name="staging_status" expression="lkp_company2.company_guid == null ? &quot;PENDING_PARENT&quot; : (lkp_group2.dealer_group_guid == null ? &quot;FAILED&quot; : &quot;MDM_LINKED&quot;)" type="id_String"/>
        <mapperTableEntries name="updated_date" expression="TalendDate.getCurrentDate()" type="id_Date"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="landing_done">
        <mapperTableEntries name="landing_guid" expression="relink_dg.landing_guid" type="id_String"/>
        <mapperTableEntries name="landing_status" expression="lkp_company2.company_guid == null ? &quot;PENDING_PARENT&quot; : (lkp_group2.dealer_group_guid == null ? &quot;FAILED&quot; : &quot;PROCESSED&quot;)" type="id_String"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="relink_dg" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="id" type="id_Long"/>
        <mapperTableEntries name="landing_guid" type="id_String"/>
        <mapperTableEntries name="company_code" type="id_String"/>
        <mapperTableEntries name="dealer_group_code" type="id_String"/>
        <mapperTableEntries name="dedup_rank" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="mdm_action" type="id_String" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="lkp_company2" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="company_guid" type="id_String"/>
        <mapperTableEntries name="company_code" expression="relink_dg.company_code" type="id_String" operator="="/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="lkp_group2" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="dealer_group_guid" type="id_String"/>
        <mapperTableEntries name="company_guid" type="id_String"/>
        <mapperTableEntries name="company_code" expression="relink_dg.company_code" type="id_String" operator="="/>
        <mapperTableEntries name="dealer_group_code" expression="relink_dg.dealer_group_code" type="id_String" operator="="/>
        <mapperTableEntries name="row_hash" type="id_String"/>
      </inputTables>
    </nodeData>

  <node componentName="tMysqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="120" posY="200">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_Recon" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MYSQL_8" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tMysqlConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;3306&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MYSQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT  '&quot; + context.batch_id.replace(&quot;'&quot;, &quot;''&quot;) + &quot;' AS batch_id,&#xD;&#xA;       lnd_co.landing_count   AS company_landing_count,&#xD;&#xA;       stg_co.staging_count   AS company_staging_count,&#xD;&#xA;       stg_co.rejected_count  AS company_rejected_count,&#xD;&#xA;       stg_co.inserted_count  AS company_inserted_count,&#xD;&#xA;       stg_co.updated_count   AS company_updated_count,&#xD;&#xA;       stg_co.unchanged_count AS company_unchanged_count,&#xD;&#xA;       lnd_dg.landing_count   AS dealer_group_landing_count,&#xD;&#xA;       stg_dg.staging_count   AS dealer_group_staging_count,&#xD;&#xA;       stg_dg.rejected_count  AS dealer_group_rejected_count,&#xD;&#xA;       stg_dg.pending_count   AS dealer_group_pending_count,&#xD;&#xA;       stg_dg.inserted_count  AS dealer_group_inserted_count,&#xD;&#xA;       stg_dg.updated_count   AS dealer_group_updated_count,&#xD;&#xA;       stg_dg.unchanged_count AS dealer_group_unchanged_count&#xD;&#xA;FROM (SELECT COUNT(*) AS landing_count&#xD;&#xA;      FROM MM_LND.LND_COMPANY_MASTER&#xD;&#xA;      WHERE batch_id =  '&quot; + context.batch_id.replace(&quot;'&quot;, &quot;''&quot;) + &quot;') lnd_co,&#xD;&#xA;     (SELECT COUNT(*) AS staging_count,&#xD;&#xA;             SUM(CASE WHEN dq_status = 'REJECTED' THEN 1 ELSE 0 END) AS rejected_count,&#xD;&#xA;             SUM(CASE WHEN mdm_action = 'INSERTED' THEN 1 ELSE 0 END) AS inserted_count,&#xD;&#xA;             SUM(CASE WHEN mdm_action = 'UPDATED' THEN 1 ELSE 0 END) AS updated_count,&#xD;&#xA;             SUM(CASE WHEN mdm_action IN ('UNCHANGED','DUPLICATE_REUSED') THEN 1 ELSE 0 END) AS unchanged_count&#xD;&#xA;      FROM MM_STG.STG_COMPANY_MASTER&#xD;&#xA;      WHERE batch_id =  '&quot; + context.batch_id.replace(&quot;'&quot;, &quot;''&quot;) + &quot;') stg_co,&#xD;&#xA;     (SELECT COUNT(*) AS landing_count&#xD;&#xA;      FROM MM_LND.LND_DEALER_GROUP_MASTER&#xD;&#xA;      WHERE batch_id =  '&quot; + context.batch_id.replace(&quot;'&quot;, &quot;''&quot;) + &quot;') lnd_dg,&#xD;&#xA;     (SELECT COUNT(*) AS staging_count,&#xD;&#xA;             SUM(CASE WHEN dq_status = 'REJECTED' THEN 1 ELSE 0 END) AS rejected_count,&#xD;&#xA;             SUM(CASE WHEN dq_status = 'PENDING_PARENT' THEN 1 ELSE 0 END) AS pending_count,&#xD;&#xA;             SUM(CASE WHEN mdm_action = 'INSERTED' THEN 1 ELSE 0 END) AS inserted_count,&#xD;&#xA;             SUM(CASE WHEN mdm_action = 'UPDATED' THEN 1 ELSE 0 END) AS updated_count,&#xD;&#xA;             SUM(CASE WHEN mdm_action IN ('UNCHANGED','DUPLICATE_REUSED') THEN 1 ELSE 0 END) AS unchanged_count&#xD;&#xA;      FROM MM_STG.STG_DEALER_GROUP_MASTER&#xD;&#xA;      WHERE batch_id =  '&quot; + context.batch_id.replace(&quot;'&quot;, &quot;''&quot;) + &quot;') stg_dg&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" value="mysql_id" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;&quot;" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;UTF-8&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="UTF-8"/>
    <elementParameter field="CHECK" name="ENABLE_STREAM" value="false"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <elementParameter field="TABLE" name="TRIM_COLUMN">
      <elementValue elementRef="SCHEMA_COLUMN" value="batch_id" id="0"/>
      <elementValue elementRef="TRIM" value="false" id="1"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="company_landing_count" id="2"/>
      <elementValue elementRef="TRIM" value="false" id="3"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="company_staging_count" id="4"/>
      <elementValue elementRef="TRIM" value="false" id="5"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="company_rejected_count" id="6"/>
      <elementValue elementRef="TRIM" value="false" id="7"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="company_inserted_count" id="8"/>
      <elementValue elementRef="TRIM" value="false" id="9"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="company_updated_count" id="10"/>
      <elementValue elementRef="TRIM" value="false" id="11"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="company_unchanged_count" id="12"/>
      <elementValue elementRef="TRIM" value="false" id="13"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="dealer_group_landing_count" id="14"/>
      <elementValue elementRef="TRIM" value="false" id="15"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="dealer_group_staging_count" id="16"/>

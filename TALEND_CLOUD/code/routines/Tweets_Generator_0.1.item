    /**
     * {talendTypes} String
     * 
     * {Category} Tweets_Generator
     * 
     * {example} getTrend() # Bill.
     */
    public static int getTrend(String polarity) {
        if(polarity == null || ("").equals(polarity) || ("null").equals(polarity)){
        	return 6;
        } else {
        	if(polarity.equals("negative")){
            	return -15;         	
            }else if(polarity.equals("neutral")){
            	return 6;
            } else if(polarity.equals("positive")){
            	return 15;
            } else {
            	return 6;
        	}
        }
    }
    
    public static String removeTrailingDots(String tweet) {
    	tweet =  tweet.replaceAll("(\\r|\\n)", "");
    	tweet =tweet.replaceAll("\u2026", "");
    	//eet =tweet.replaceAll("0xE20x800xA6 ", "");
    	/*if (tweet.endsWith("...."))
    	{
    		tweet =  tweet.substring(0, tweet.length()-5);
    	} */
    	return tweet;
    }
